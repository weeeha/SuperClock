{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host"],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3050,
      "env": { "PORT": "3050" }
    },
    {
      "name": "dev-3050",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "--port", "3050", "--strictPort"],
      "port": 3050,
      "autoPort": false
    }
  ]
}
