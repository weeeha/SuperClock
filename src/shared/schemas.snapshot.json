    "device.config": {
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "enum": [
            "superclock-fast",
            "superclock-small",
            "superclock-square",
            "superclock-slow"
          ],
          "type": "string"
        },
        "enabledApps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "instances": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "appId": {
                "minLength": 1,
                "type": "string"
              },
              "config": {
                "additionalProperties": {},
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "appId",
              "config"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "playlist": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "rotationSeconds": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "items",
            "rotationSeconds"
          ],
          "type": "object"
        },
        "settings": {
          "additionalProperties": false,
          "properties": {
            "accent": {
              "type": "string"
            },
            "brightness": {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "night": {
              "additionalProperties": false,
              "properties": {
                "brightness": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "integer"
                },
                "end": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                "start": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "type": "object"
            },
            "skin": {
              "enum": [
                "fields"
              ],
              "type": "string"
            },
            "sleepSchedule": {
              "additionalProperties": false,
              "properties": {
                "sleep": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                "wake": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                }
              },
              "required": [
                "wake",
                "sleep"
              ],
              "type": "object"
            },
            "theme": {
              "enum": [
                "light",
                "dark",
                "system"
              ],
              "type": "string"
            }
          },
          "required": [
            "theme",
            "accent"
          ],
          "type": "object"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "deviceId",
        "enabledApps",
        "instances",
        "playlist",
        "settings",
        "updatedAt"
      ],
      "type": "object"
    },
